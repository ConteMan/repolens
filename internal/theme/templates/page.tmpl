{{define "page"}}
{{if and .TOC (eq .TOCPanel "inline")}}<nav class="toc" data-i18n-aria-label="toc_title" aria-label="{{index .UI "toc_title"}}">{{range .TOC}}{{template "toc-item" .}}{{end}}</nav>{{end}}
{{if eq .Kind "dir"}}
  {{template "dirlist" .}}
{{else}}
  <article class="page page-{{.Kind}}">{{.Body}}</article>
{{end}}{{template "glossary-appendix" .}}
{{end}}

{{define "toc-item"}}<a class="toc-link toc-level-{{.Level}}" href="#{{.Anchor}}">{{.Title}}</a>{{range .Children}}{{template "toc-item" .}}{{end}}{{end}}
